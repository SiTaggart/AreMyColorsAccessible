// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`About > renders without crashing 1`] = `
<DocumentFragment>
  .emotion-0 {
  padding-top: 3rem;
  position: relative;
}

.emotion-1 {
  margin: 0 auto;
  max-width: 1150px;
  padding: 0 1rem;
}

.emotion-2 {
  font-weight: 700;
  font-size: 2.4rem;
  text-align: center;
}

@media (min-width: 768px) {
  .emotion-2 {
    font-size: 3rem;
  }
}

.emotion-4 {
  margin: 3rem 1rem;
}

@media (min-width: 1024px) {
  .emotion-4 {
    margin: 3rem -3rem;
  }
}

.emotion-4 p {
  font-size: 1.4rem;
  font-style: italic;
}

.emotion-4 cite {
  font-size: 1rem;
  font-style: normal;
}

.emotion-6 {
  color: currentColor;
}

.emotion-14 {
  font-weight: 700;
}

<main
    class="emotion-0"
  >
    <div
      class="emotion-1"
    >
      <h1
        class="emotion-2"
      >
        Are my Colours Accessible?
      </h1>
      <p
        class="emotion-3"
      >
        Why? Well, apart from being an excuse to use a domain name, colour contrast and the use of colour is extremely important for certain groups of people with varying levels of visional impairment.
      </p>
      <blockquote
        class="emotion-4"
      >
        <p
          class="emotion-3"
        >
          Information and user interface components must be presentable to users in ways they can perceive. 
          <br />
          <cite>
            – 
            <a
              class="emotion-6"
              href="https://www.w3.org/TR/2008/REC-WCAG20-20081211/#perceivable"
            >
              Principle 1: Perceivable
            </a>
            , WCAG 2.0 Guidelines
          </cite>
        </p>
      </blockquote>
      <blockquote
        class="emotion-4"
      >
        <p
          class="emotion-3"
        >
          Make it easier for users to see and hear content including separating foreground from background.
          <br />
          <cite>
            – 
            <a
              class="emotion-6"
              href="https://www.w3.org/TR/2008/REC-WCAG20-20081211/#visual-audio-contrast"
            >
              Guideline 1.4 Distinguishable:
            </a>
             WCAG 2.0 Guidelines
          </cite>
        </p>
      </blockquote>
      <blockquote
        class="emotion-4"
      >
        <p
          class="emotion-3"
        >
          The visual presentation of text and images of text has a contrast ratio of at least 4.5:1, except for the following: (Level AA).
          <br />
          <cite>
            – 
            <a
              class="emotion-6"
              href="https://www.w3.org/TR/2008/REC-WCAG20-20081211/#visual-audio-contrast"
            >
              1.4.3 Contrast (Minimum):
            </a>
             WCAG 2.0 Guidelines
          </cite>
        </p>
      </blockquote>
      <p
        class="emotion-3"
      >
        Aim for 4.5:1 to meet WCAG AA. Large text (18pt / 24px+) or 
        <strong>
          bold
        </strong>
         text (14pt / 18px+) can pass at 3:1. AAA wants 7:1 for normal text and 4.5:1 for large or bold. Small, Bold and Large show how you do at both.
      </p>
      <h2
        class="emotion-14"
      >
        Two algorithms
      </h2>
      <p
        class="emotion-3"
      >
        This site uses WCAG 2 and APCA. Flip between them on the home page or the palette. WCAG gives a contrast ratio with AA/AAA. APCA gives an Lc score instead.
      </p>
      <p
        class="emotion-3"
      >
        For APCA, 
        <strong>
          Yup
        </strong>
         means Content passes (Lc 60+). 
        <strong>
          Kinda
        </strong>
         means only Large does (45+). 
        <strong>
          Nope
        </strong>
         is below that.
      </p>
      <p
        class="emotion-3"
      >
        APCA row targets: Fluent 90, Body 75, Content 60, Large 45, Minimum 30, Non-Text 15.
      </p>
      <p
        class="emotion-3"
      >
        Building upon and heavily influenced by the excellent 
        <a
          class="emotion-6"
          href="http://jxnblk.com/colorable/"
        >
          Colorable
        </a>
        , I wanted more context around the result. When you share the outcome with your colleagues, all the results, rules and what you’re aiming for, is easily understandable for when you have those awkward conversations with designers and marketers.
      </p>
      <p
        class="emotion-3"
      >
        Accessibility doesn’t have to be ugly.
      </p>
      <p
        class="emotion-3"
      >
        Built by 
        <a
          class="emotion-6"
          href="http://www.simontaggart.com"
        >
          Simon Taggart
        </a>
        , 
        <a
          class="emotion-6"
          href="https://github.com/SiTaggart/AreMyColorsAccessible"
        >
          code on GitHub
        </a>
        , 
        <a
          class="emotion-6"
          href="https://netlify.com"
        >
          hosted on Netlify
        </a>
        .
      </p>
    </div>
  </main>
</DocumentFragment>
`;
