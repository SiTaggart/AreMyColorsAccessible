{
  "name": "aremycolorsaccessible",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "author": "Simon Taggart <me@simontaggart.com> (http://simontaggart.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiTaggart/AreMyColorsAccessible"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "bun run typecheck && vite build",
    "typecheck": "bun run cf-typegen && tsgo --noEmit",
    "lint": "oxlint scripts src vite.config.ts vitest.config.ts playwright.config.ts oxlint.config.ts",
    "lint:fix": "oxlint scripts src vite.config.ts vitest.config.ts playwright.config.ts oxlint.config.ts --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "smoke": "bun run build && bun run smoke:routes",
    "smoke:routes": "bun run scripts/smoke-routes.ts",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-start": "1.168.25",
    "@twilio-paste/core": "21.5.0",
    "@twilio-paste/icons": "12.9.0",
    "color": "4.2.3",
    "color-combos": "1.2.1",
    "lodash": "4.18.1",
    "normalize.css": "8.0.1",
    "polished": "4.3.1",
    "prism-react-renderer": "2.4.1",
    "query-string": "7.1.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.40.0",
    "@emotion/jest": "11.14.2",
    "@nkzw/eslint-plugin": "2.0.0",
    "@nkzw/oxlint-config": "1.2.1",
    "@playwright/test": "1.60.0",
    "@tanstack/react-router-devtools": "1.167.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/color": "4.2.1",
    "@types/lodash": "4.17.24",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "29.1.1",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "wrangler": "4.98.0"
  },
  "engines": {
    "node": "26.3.0"
  },
  "packageManager": "bun@1.3.5"
}
