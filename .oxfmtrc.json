{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "tabWidth": 2,
  "trailingComma": "es5",
  "arrowParens": "always",
  "ignorePatterns": [
    "dist",
    ".wrangler",
    "coverage",
    "playwright-report",
    ".github/workflows/nextjs_bundle_analysis.yml",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts"
  ]
}
