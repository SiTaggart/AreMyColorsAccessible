{
  "name": "aremycolorsaccessible",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "author": "Simon Taggart <me@simontaggart.com> (http://simontaggart.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiTaggart/AreMyColorsAccessible"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "smoke": "bun run build && bun run smoke:routes",
    "smoke:routes": "bun run scripts/smoke-routes.ts",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-start": "^1.168.13",
    "@twilio-paste/core": "20.11.0",
    "@twilio-paste/icons": "12.4.0",
    "color": "4.2.3",
    "color-combos": "1.1.0",
    "lodash": "4.17.21",
    "normalize.css": "8.0.1",
    "polished": "4.3.1",
    "prism-react-renderer": "2.3.1",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@emotion/jest": "11.11.0",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/color": "3.0.6",
    "@types/lodash": "4.17.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.5"
}
