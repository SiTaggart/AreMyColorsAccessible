{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "are-my-colors-accessible",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
